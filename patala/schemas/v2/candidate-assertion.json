{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patala.org/schemas/v2/candidate-assertion.json",
  "title": "CandidateAssertion — a claim extracted from a source (not yet resolved)",
  "type": "object",
  "required": ["id", "observation_id", "predicate", "extraction_method", "extractor_version"],
  "properties": {
    "id": { "type": "string", "pattern": "^PTCAS_" },
    "observation_id": { "type": "string", "pattern": "^PTOBS_" },
    "subject_candidate_id": { "type": ["string", "null"] },
    "predicate": {
      "type": "string",
      "enum": [
        "TITLE", "AUTHOR", "EDITOR", "COMMENTATOR", "DATE", "TRADITION",
        "LANGUAGE", "WORK_IDENTITY", "EDITION_OF", "TRANSLATION_OF",
        "WITNESS_OF", "PART_OF", "HAS_PASSAGE", "OTHER"
      ]
    },
    "value": { "type": "string" },
    "object_id": { "type": ["string", "null"] },
    "source_selector": { "type": ["object", "null"] },
    "extraction_method": {
      "type": "string",
      "enum": [
        "STRUCTURED_FIELD", "CSS_SELECTOR", "XML_PATH", "REGEX",
        "DETERMINISTIC_PARSE", "LLM_EXTRACTION", "HUMAN"
      ]
    },
    "extractor_version": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

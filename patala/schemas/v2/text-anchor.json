{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patala.org/schemas/v2/text-anchor.json",
  "title": "TextAnchor — a selector pointing to exact text in a source",
  "description": "Per newbuild1 §43: 'Use multiple selectors. W3C Web Annotation model.'",
  "type": "object",
  "required": ["id", "source_artifact_id", "selectors", "source_digest"],
  "properties": {
    "id": { "type": "string", "pattern": "^PTANC_" },
    "source_artifact_id": { "type": "string" },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["TextPosition", "TextQuote", "XPath", "XmlId", "IIIFRegion"] },
          "start": { "type": ["integer", "null"] },
          "end": { "type": ["integer", "null"] },
          "exact": { "type": ["string", "null"] },
          "prefix": { "type": ["string", "null"] },
          "suffix": { "type": ["string", "null"] },
          "xpath": { "type": ["string", "null"] },
          "xml_id": { "type": ["string", "null"] },
          "region": { "type": ["object", "null"] }
        }
      }
    },
    "source_digest": { "type": "object", "description": "DigestSet of the source artifact" },
    "normalization_profile": { "type": ["string", "null"] }
  }
}
